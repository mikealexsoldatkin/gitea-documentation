# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


# Obsidian workspace
workspace.json
graph.json
.env
.bitbucket
mcp_settings.json
/.infio_json_db/chats/
/.infio_json_db/workspaces/
/.infio_json_db/commands/
/.infio_json_db/convert_data/
/.claudian/sessions
/.obsidian/plugins/realclaudian/data.json
/source-code/